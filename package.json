{
  "name": "bulk-page-analyzer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "prod": "docker compose up --build",
    "dev:api": "yarn workspace @bulk/api dev",
    "dev:web": "yarn workspace @bulk/web dev",
    "dev:worker": "yarn workspace @bulk/worker dev",
    "db:generate": "yarn workspace @bulk/db generate",
    "db:migrate": "yarn workspace @bulk/db migrate",
    "test": "yarn workspace @bulk/web test && yarn workspace @bulk/api test"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "packageManager": "yarn@4.5.0"
}
